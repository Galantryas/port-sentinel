{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Port Sentinel",
  "version": "0.1.0",
  "identifier": "com.portsentinel.devmonitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "title": "Port Sentinel"
    },
    "windows": [
      {
        "title": "Port Sentinel",
        "width": 400,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "skipTaskbar": true,
        "visible": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
